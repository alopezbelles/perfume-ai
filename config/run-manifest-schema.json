{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "perfume_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "perfume_name": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "input_url": { "type": "string", "pattern": "^https?://\\S+$" },
    "status": { "type": "string", "enum": ["running", "completed", "failed"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrape": { "$ref": "#/definitions/stage" },
        "art_direction": { "$ref": "#/definitions/stage" },
        "prompts": { "$ref": "#/definitions/stage" },
        "image_editorial": { "$ref": "#/definitions/stage" },
        "image_surreal": { "$ref": "#/definitions/stage" }
      },
      "required": ["scrape", "art_direction", "prompts", "image_editorial", "image_surreal"]
    }
  },
  "required": ["schema_version", "perfume_id", "perfume_name", "run_id", "input_url", "status", "created_at", "updated_at", "stages"],
  "definitions": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "running", "completed", "failed"] },
        "started_at": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "required": ["status"]
    }
  }
}
