        "composition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": "string"
            },
            "element_density": {
              "type": "string"
            },
            "depth": {
              "type": "string"
            },
            "bottle_priority": {
              "type": "string"
            },
            "negative_space": {
              "type": "string"
            },
            "enveloping_structure": {
              "type": "string",
              "minLength": 1,
              "description": "A dominant material structure derived from the selected notes connects foreground, the space close to the bottle and background; adapt it to each fragrance rather than forcing a liquid ribbon."
            },
            "primary_clusters": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Describe two or three unequal, compact ingredient groupings close to the bottle sides, their dominant selected notes, relative positions and connections."
            },
            "foreground_plan": {
              "type": "string",
              "minLength": 1,
              "description": "Describe nearby overlapping ingredient masses, partially cropped by the frame and softly defocused, at realistic physical scale."
            },
            "midground_plan": {
              "type": "string",
              "minLength": 1,
              "description": "Concentrate the principal ingredient groupings close to the bottle and behind its silhouette, maintaining full product visibility through contrast, light and focus."
            },
            "background_plan": {
              "type": "string",
              "minLength": 1,
              "description": "Continue the main material structure and ingredient masses behind the bottle into atmospheric depth and toward the image edges."
            },
            "overlap_plan": {
              "type": "string",
              "minLength": 1,
              "description": "Specify which ingredients overlap one another and which pass behind the bottle; nothing obscures the bottle, cap or label."
            },
            "negative_space_plan": {
              "type": "string",
              "minLength": 1,
              "description": "Place small, irregular breathing areas between ingredient masses; never create a wide empty halo around the bottle."
            }
          },
