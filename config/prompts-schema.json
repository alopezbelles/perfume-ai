{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "perfume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "gender": { "type": "string", "enum": ["male", "female", "unknown"] },
        "bottle_reference": { "type": ["string", "null"] }
      },
      "required": ["name", "gender", "bottle_reference"]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editorial_still_life": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "prompt": { "type": "string", "minLength": 1 } },
          "required": ["prompt"]
        },
        "immersive_surreal": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "prompt": { "type": "string", "minLength": 1 } },
          "required": ["prompt"]
        }
      },
      "required": ["editorial_still_life", "immersive_surreal"]
    }
  },
  "required": ["perfume", "images"]
}
